<Window x:Class="TableSnip.SnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snip" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="False" Background="Black" WindowStartupLocation="Manual"
        Left="0" Top="0" Width="400" Height="300" Cursor="Cross" ShowActivated="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="Root" Background="Black">
        <Image x:Name="Shot" Stretch="Fill"/>
        <Path x:Name="Dim" Fill="#5C000000"/>
        <Canvas x:Name="Overlay">
            <Rectangle x:Name="SelShadow" Stroke="#66000000" StrokeThickness="3" Visibility="Collapsed"/>
            <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="1" Visibility="Collapsed"/>
            <Border x:Name="SizeLabel" Visibility="Collapsed" Background="#E6202020" CornerRadius="4" Padding="7,3">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="11" FontFamily="Segoe UI Variable Text, Segoe UI"/>
            </Border>
        </Canvas>
        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0"
                Background="#E6202020" CornerRadius="8" Padding="18,10" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Path Data="M2,6 V3.5 A1.5,1.5 0 0 1 3.5,2 H6 M10,2 H12.5 A1.5,1.5 0 0 1 14,3.5 V6 M14,10 V12.5 A1.5,1.5 0 0 1 12.5,14 H10 M6,14 H3.5 A1.5,1.5 0 0 1 2,12.5 V10"
                      Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="16" Height="16" Stretch="None" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Foreground="White" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center"
                           Text="Drag a box around the table   ·   Esc to cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
