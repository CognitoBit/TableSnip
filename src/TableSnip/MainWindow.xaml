<Window x:Class="TableSnip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TableSnip" Width="920" Height="600" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver" PreviewDragLeave="Window_PreviewDragLeave" PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown" Activated="Window_Activated">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Toolbar ================= -->
        <Grid Grid.Row="0" Margin="16,12,16,10">
            <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SnipButton" Style="{StaticResource AccentButton}" Click="Snip_Click"
                        ToolTip="Select a table anywhere on your screen (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconSnip}"/>
                        <TextBlock Text="Snip table" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="Paste_Click"
                        ToolTip="Paste a screenshot from the clipboard (Ctrl+V)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPaste}"/>
                        <TextBlock Text="Paste" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="Open_Click" ToolTip="Open an image file (Ctrl+O)">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconOpen}"/>
                </Button>
            </StackPanel>

            <StackPanel x:Name="ResultTools" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                <TextBlock Text="Columns" Style="{StaticResource Muted}" Margin="0,0,10,0"
                           ToolTip="Drag if the table came out with too few or too many columns"/>
                <TextBlock Text="fewer" Style="{StaticResource Muted}" FontSize="11"/>
                <Slider x:Name="GapSlider" Style="{StaticResource GapSlider}" Width="120" Margin="6,0"
                        Minimum="0" Maximum="100" Value="50" LargeChange="10" SmallChange="5"
                        IsMoveToPointEnabled="True" ValueChanged="GapSlider_ValueChanged"
                        ToolTip="Drag if the table came out with too few or too many columns"/>
                <TextBlock Text="more" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                <Button x:Name="CopyButton" Style="{StaticResource AccentButton}" Click="Copy_Click" MinWidth="118"
                        ToolTip="Copy the whole table to the clipboard (Ctrl+Shift+C)">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="CopyIcon" Style="{StaticResource Icon}" Data="{StaticResource IconCopy}"/>
                        <TextBlock x:Name="CopyLabel" Text="Copy table" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Content ================= -->
        <Grid Grid.Row="1" Margin="16,0,16,0">

            <!-- Empty state -->
            <Grid x:Name="EmptyState">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <Border Width="72" Height="72" CornerRadius="18" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconSnip}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform" Margin="20"/>
                    </Border>
                    <TextBlock Text="Turn any table on your screen into cells" FontSize="21" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,22,0,8"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"
                               Text="Snip a table from a PDF, web page or any app. It is read right here on your PC and copied to your clipboard, ready to paste into Excel or Google Sheets."/>
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,26,0,0" Padding="22,11" FontSize="14"
                            Click="Snip_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSnip}"/>
                            <TextBlock Text="Snip a table" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,10,0,0"
                               Text="Press Ctrl+Alt+T from any app"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,28,0,0"
                               Text="Ctrl+V pastes a screenshot from the clipboard  ·  or drop an image file here"/>
                </StackPanel>
            </Grid>

            <!-- Result -->
            <Grid x:Name="ResultView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PreviewColumn" Width="300" MinWidth="0"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="PreviewBorder" Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"
                               HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="False"/>

                <Border x:Name="GridBorder" Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" SizeChanged="GridBorder_SizeChanged">
                    <Border.Clip>
                        <RectangleGeometry x:Name="GridClip" RadiusX="8" RadiusY="8"/>
                    </Border.Clip>
                    <DataGrid x:Name="Grid" Style="{StaticResource TableGrid}"
                              AutoGeneratingColumn="Grid_AutoGeneratingColumn" LoadingRow="Grid_LoadingRow"
                              CellEditEnding="Grid_CellEditEnding"/>
                </Border>
            </Grid>

            <!-- Drop hint -->
            <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="10"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="Drop the image to read it" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Busy overlay -->
            <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="{DynamicResource Brush.Busy}" CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Path x:Name="Spinner" Width="22" Height="22" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M11,2 A9,9 0 1 1 2,11" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Text="Reading the table…" FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Footer ================= -->
        <Grid Grid.Row="2" Margin="16,10,16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="StatusIcon" Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Width="14" Height="14"
                      Stroke="{DynamicResource Brush.Success}" Margin="0,0,7,0" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Text="" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel x:Name="FooterTools" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                <Button Style="{StaticResource IconButton}" Click="SaveCsv_Click" ToolTip="Save as CSV file">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconSave}"/>
                        <TextBlock Text="Save CSV" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PreviewToggle" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="TogglePreview_Click"
                        ToolTip="Show or hide the captured image">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconEye}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
